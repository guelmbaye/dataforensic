# ---------------------------------------------------------------------------
# DATAFORENSIC AI - configuration
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# The only CORS surface in the project: the browser calls the API directly,
# including the SSE stream. In production this is the frontend origin, e.g.
# https://dataforensic.vylantic.com (see docs/DEPLOY-DIGITALOCEAN.md).
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Docker Compose provides PostgreSQL. For a local run without Docker, SQLite
# works out of the box: sqlite+aiosqlite:///./dataforensic.db
DATABASE_URL=postgresql+asyncpg://dataforensic:dataforensic@postgres:5432/dataforensic

# --- DataHub ---------------------------------------------------------------
# DATAHUB_MODE controls where the context graph comes from:
#   live    - require a real DataHub; fail loudly if it is unreachable
#   fixture - always use the deterministic local graph (offline demo)
#   auto    - try live, fall back to fixture and label every result DEMO_FIXTURE
DATAHUB_MODE=auto
DATAHUB_URL=http://datahub-gms:8080
DATAHUB_TOKEN=
# The bridge that exposes the stdio MCP server over Streamable HTTP.
DATAHUB_MCP_URL=http://dataforensic-mcp:8000/mcp
DATAHUB_TIMEOUT_SECONDS=20
DATAHUB_WRITEBACK_ENABLED=true

# --- LLM (optional) --------------------------------------------------------
# The deterministic engine always decides the root cause. An LLM only adds
# extra candidate hypotheses (which must cite existing evidence) and narration.
# Leave as 'none' for a fully reproducible demo.
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_BASE_URL=

# --- Agent tuning ----------------------------------------------------------
AGENT_LINEAGE_DEPTH=4
AGENT_LOOKBACK_MINUTES=720
CONFIDENCE_CONFIRM_THRESHOLD=0.85
CONFIDENCE_SUPPORT_THRESHOLD=0.60

# --- Safety ----------------------------------------------------------------
# Real (non simulated) remediation stays disabled. The backend refuses it even
# if the agent asks for it.
ALLOW_REAL_REMEDIATION=false

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
